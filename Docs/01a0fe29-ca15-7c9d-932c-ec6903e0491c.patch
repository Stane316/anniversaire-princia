+
+/* ---------- Révélation générique au scroll (Reveal) ---------- */
+[data-reveal] {
+  transition:
+    opacity 600ms ease var(--reveal-delay, 0ms),
+    translate 600ms cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0ms);
+}
+/* Contenu visible PAR DÉFAUT. Le masquage n'est ARMÉ (« reveal-armed »
+   sur <html>) que lorsqu'un callback IntersectionObserver réel a prouvé
+   que la machine de révélation tourne (posé par useInView). En contexte
+   dégradé (Observer muet, version mélangée par un vieux service
+   worker…), la classe n'est jamais posée : le texte reste toujours
+   affiché — le contenu prime toujours sur l'effet. */
+.reveal-armed [data-reveal]:not(.is-in) {
+  opacity: 0;
+  translate: 0 18px;
+}
+@media (prefers-reduced-motion: reduce) {
+  [data-reveal] {
+    transition: none !important;
+    opacity: 1 !important;
+    translate: none !important;
+  }
+}
+
+/* ---------- Scène ---------- */
