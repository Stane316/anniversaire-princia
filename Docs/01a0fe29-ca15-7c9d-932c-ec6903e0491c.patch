+}
+@media (prefers-reduced-motion: reduce) {
+  .souvenir-intro { transition: opacity 240ms ease, visibility 0s linear 240ms; /* reduced-motion : sortie brève inchangée */ }
+  .souvenir-intro__loading { animation: none; }
+}
+
+/* ============================================================
+   RefineFrame (composant Stane) — révélation progressive d'un
+   média. Classes projet traduites des utilitaires Tailwind de la
+   source, pilotées par les variables --rf-* et les attributs
+   data-status / data-mosaic / data-resolved / data-sweep.
+   ============================================================ */
+.refine-frame {
+  position: relative;
+  isolation: isolate;
+  overflow: hidden;
+  width: min(var(--rf-w, 320px), 100%);
+  aspect-ratio: var(--rf-aspect, 4 / 3);
+  border-radius: var(--rf-radius, 16px);
+  background: var(--rf-bg, #0f2444);
+  color: var(--rf-ink, #eaf3ff);
+  font-size: 12px;
+  line-height: 1;
+  font-weight: 500;
+  font-family: inherit;
+}
+.refine-frame__stage {
+  position: absolute;
+  inset: 0;
+  opacity: var(--rf-opacity, 1);
+  filter: blur(var(--rf-blur, 0px)) saturate(var(--rf-sat, 1));
+  transform: scale(var(--rf-scale, 1));
+  transition:
+    opacity var(--rf-stage, 400ms) cubic-bezier(0.23, 1, 0.32, 1),
+    filter var(--rf-stage, 400ms) cubic-bezier(0.23, 1, 0.32, 1),
+    transform var(--rf-stage, 400ms) cubic-bezier(0.23, 1, 0.32, 1);
+}
+.refine-frame[data-status="queued"] .refine-frame__stage {
+  animation: refine-frame-wait 2.4s ease-in-out infinite;
+}
+.refine-frame__print {
+  height: 100%;
+  width: 100%;
+  transition: opacity var(--rf-stage, 400ms) ease;
+}
+.refine-frame__print > * {
+  display: block;
+  height: 100%;
+  width: 100%;
+  object-fit: cover;
+}
+.refine-frame[data-mosaic] .refine-frame__print { opacity: 0; }
+.refine-frame[data-resolved] .refine-frame__print { opacity: 1 !important; }
+
+.refine-frame__canvas {
+  pointer-events: none;
+  position: absolute;
+  inset: 0;
+  height: 100%;
+  width: 100%;
+  opacity: 0;
+  transition: opacity var(--rf-stage, 400ms) ease;
+}
+.refine-frame[data-mosaic] .refine-frame__canvas { opacity: 1; }
+.refine-frame[data-resolved] .refine-frame__canvas { opacity: 0 !important; }
+
+.refine-frame__sweep {
+  pointer-events: none;
+  position: absolute;
+  inset: 0;
+  opacity: 0;
+  background: linear-gradient(
+    115deg,
+    transparent 38%,
+    color-mix(in srgb, var(--rf-ink, #eaf3ff) 14%, transparent) 50%,
+    transparent 62%
+  );
+  background-size: 260% 100%;
+  transition: opacity var(--rf-stage, 400ms) ease;
+}
+.refine-frame[data-sweep] .refine-frame__sweep {
+  opacity: 1;
+  animation: refine-frame-sweep 2.2s linear infinite;
+}
+.refine-frame[data-mosaic] .refine-frame__sweep {
+  opacity: 0 !important;
+  animation: none;
+}
+
+.refine-frame__chip {
+  pointer-events: none;
+  position: absolute;
+  bottom: 10px;
+  left: 10px;
+  display: inline-flex;
+  height: 26px;
+  transform: translateY(0);
+  align-items: center;
+  gap: 6px;
+  border-radius: 13px;
+  padding: 0 10px 0 8px;
+  opacity: 1;
+  backdrop-filter: blur(8px);
+  background: color-mix(in srgb, var(--rf-bg, #0f2444) 72%, transparent);
+  transition:
+    opacity 200ms ease,
+    transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
+}
+@starting-style {
+  .refine-frame__chip {
+    transform: translateY(4px);
+    opacity: 0;
+  }
+}
+.refine-frame__chip-mark {
+  display: inline-flex;
+  color: color-mix(in srgb, var(--rf-ink, #eaf3ff) 80%, transparent);
+}
+.refine-frame__chip-mark[data-kind="spin"] {
+  animation: refine-frame-spin 1.1s linear infinite;
+}
+.refine-frame__chip-mark[data-kind="error"] {
+  color: #ef9aa9;
+}
+.refine-frame__label {
+  animation: refine-frame-label 200ms ease both;
+}
+
+.refine-frame__retry {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  display: inline-flex;
+  height: 32px;
+  transform: translate(-50%, -50%);
+  cursor: pointer;
+  align-items: center;
+  gap: 6px;
+  border-radius: 16px;
+  border: 0;
+  padding: 0 14px 0 12px;
+  font-size: 13px;
+  font-weight: 500;
+  outline: none;
+  background: color-mix(in srgb, var(--rf-ink, #eaf3ff) 14%, var(--rf-bg, #0f2444));
+  color: var(--rf-ink, #eaf3ff);
+  font-family: inherit;
+  -webkit-tap-highlight-color: transparent;
+  transition:
+    opacity 200ms ease,
+    transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
+    background-color 150ms ease;
+}
+.refine-frame__retry:active { transform: translate(-50%, -50%) scale(0.96); }
+@media (hover: hover) and (pointer: fine) {
+  .refine-frame__retry:hover {
+    background: color-mix(in srgb, var(--rf-ink, #eaf3ff) 20%, var(--rf-bg, #0f2444));
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .refine-frame__stage {
+    transition: opacity var(--rf-stage, 400ms) ease;
+  }
+  .refine-frame[data-status="queued"] .refine-frame__stage { animation: none !important; }
+  .refine-frame[data-sweep] .refine-frame__sweep {
+    opacity: 0 !important;
+    animation: none !important;
+  }
+  .refine-frame__chip { transition: opacity 200ms ease; }
+  .refine-frame__chip-mark[data-kind="spin"] { animation: none !important; }
+  .refine-frame__retry { transition: opacity 200ms ease; }
+  .refine-frame__retry:active { scale: none; transform: translate(-50%, -50%); }
+}
+
+.daily-dock {
+  position: fixed;
+  bottom: max(12px, env(safe-area-inset-bottom, 0px));
+  left: 50%;
+  transform: translateX(-50%);
+  z-index: 50;
+  width: 100%;
+  display: flex;
+  justify-content: center;
+  pointer-events: none;
+}
+.daily-dock .dock {
+  pointer-events: auto;
+  display: flex;
+  max-width: min(96vw, 560px);
+  justify-content: center;
+  /* Rail ancré EN BAS du cadre animé (comme le absolute bottom-2 de la
+     source) : sans cet ancrage, le rail remontait pendant l'étirement
+     du cadre, la souris le « perdait » (mouseleave), il se repliait,
+     la retrouvait… va-et-vient incessant signalé le 3 oct. 2026. */
+  align-items: flex-end;
+}
+.dock__panel {
+  display: flex;
+  align-items: flex-end;
+  gap: clamp(0.5rem, 2vw, 1rem);
+  padding: 0.45rem clamp(0.75rem, 2.5vw, 1.25rem);
