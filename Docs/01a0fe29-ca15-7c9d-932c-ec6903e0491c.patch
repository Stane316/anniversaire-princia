++}
++.case-file--verdict {
++  position: relative;
++}
++.case-file--verdict > .exlibris {
++  position: absolute;
++  top: var(--space-6);
++  right: var(--space-6);
++}
++@media (max-width: 560px) {
++  .case-file--verdict > .exlibris {
++    position: static;
++    margin-left: auto;
++    display: flex;
++  }
++}
