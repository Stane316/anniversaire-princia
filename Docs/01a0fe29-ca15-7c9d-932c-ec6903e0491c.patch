+/* ============================================================
+   PRINCIA — Chapter 18 · Design tokens
+   Source : Doc 02 — Visual & Motion Direction (§04–§06, §12)
+   Toutes les décisions récurrentes sont centralisées ici.
+   ============================================================ */
+
+:root {
+  /* ---- Palette principale (doc 02 §04.1) ---- */
+  --color-background: #f7faff;
+  --color-surface: #ffffff;
+  --color-surface-soft: #edf4ff;
+  --color-surface-blue: #dcebff;
+  --color-primary: #3978d4;
+  --color-primary-hover: #2d65b8;
+  --color-primary-active: #24559f;
+  --color-primary-strong: #174a91;
+  --color-blue-deep: #15345b;
+  --color-accent: #8ec5ff;
+  --color-accent-soft: #d8e9ff;
+
+  /* ---- Neutres (doc 02 §04.2) ---- */
+  --color-text: #17263d;
+  --color-text-secondary: #52627a;
+  --color-text-muted: #687991;
+  --color-border: #dce5f0;
+  --color-border-strong: #b8c9df;
+  --color-overlay: rgba(15, 35, 65, 0.48);
+
+  /* ---- Sémantique (doc 02 §04.3) ---- */
+  --color-success: #247a55;
+  --color-success-bg: #e3f3ec;
+  --color-warning: #946000;
+  --color-warning-bg: #f8eeda;
+  --color-error: #b42335;
+  --color-error-bg: #fbe9eb;
+  --color-info: #245fa8;
+  --color-info-bg: #e4eefb;
+
+  /* ---- Typographie (doc 02 §05) ---- */
+  --font-serif: "DM Serif Display", Georgia, "Times New Roman", serif;
+  --font-sans: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
+  --font-mono: "IBM Plex Mono", ui-monospace, "SF Mono", Consolas, monospace;
+  --font-hand: "Kalam", "Segoe Script", "Bradley Hand", cursive;
+
+  --text-display: clamp(2.8rem, 7vw, 5.5rem);
+  --text-h1: clamp(2.25rem, 5vw, 4rem);
+  --text-h2: clamp(1.8rem, 3.5vw, 2.8rem);
+  --text-h3: clamp(1.4rem, 2.6vw, 1.75rem);
+  --text-h4: clamp(1.125rem, 2vw, 1.375rem);
+  --text-body-lg: 1.125rem;
+  --text-body: 1rem;
+  --text-body-sm: 0.875rem;
+  --text-caption: 0.8125rem;
+  --text-label: 0.875rem;
+
+  --leading-display: 1.08;
+  --leading-heading: 1.2;
+  --leading-body: 1.65;
+  --leading-meta: 1.45;
+
+  /* ---- Espacement (doc 02 §06.2) ---- */
+  --space-1: 4px;
+  --space-2: 8px;
+  --space-3: 12px;
+  --space-4: 16px;
+  --space-5: 20px;
+  --space-6: 24px;
+  --space-8: 32px;
+  --space-10: 40px;
+  --space-12: 48px;
+  --space-16: 64px;
+  --space-20: 80px;
+  --space-24: 96px;
+
+  /* ---- Rayons (doc 02 §06.3) ---- */
+  --radius-sm: 8px;
+  --radius-md: 12px;
+  --radius-lg: 18px;
+  --radius-xl: 24px;
+  --radius-2xl: 32px;
+  --radius-full: 999px;
+
+  /* ---- Ombres (doc 02 §06.4) ---- */
+  --shadow-soft: 0 1px 2px rgba(21, 52, 91, 0.05), 0 6px 18px rgba(21, 52, 91, 0.07);
+  --shadow-card: 0 2px 4px rgba(21, 52, 91, 0.06), 0 14px 34px rgba(21, 52, 91, 0.11);
+  --shadow-overlay: 0 10px 30px rgba(15, 35, 65, 0.22);
+
+  /* ---- Largeurs de lecture (doc 02 §06.5) ---- */
+  --measure-readable: 720px;
+  --measure-editorial: 960px;
+  --measure-app: 1200px;
+  --measure-library: 1360px;
+
+  /* ---- Motion (doc 02 §12) ---- */
+  --motion-instant: 100ms;
+  --motion-fast: 160ms;
+  --motion-standard: 240ms;
+  --motion-emphasis: 360ms;
+  --motion-narrative: 520ms;
+  --motion-scene: 700ms;
+
+  --ease-standard: cubic-bezier(0.2, 0.7, 0.2, 1);
+  --ease-enter: cubic-bezier(0.16, 1, 0.3, 1);
+  --ease-exit: cubic-bezier(0.4, 0, 1, 1);
+  --ease-balanced: cubic-bezier(0.65, 0, 0.35, 1);
+
+  /* ---- Navigation quotidienne ---- */
+  --nav-height: 64px;
+}
