+}
+
+.badge--blue {
+  background: var(--color-accent-soft);
+  color: var(--color-primary-strong);
+}
+
+.badge--success {
+  background: var(--color-success-bg);
+  color: var(--color-success);
+}
+
+.badge--warning {
+  background: var(--color-warning-bg);
+  color: var(--color-warning);
+}
+
+.badge--info {
+  background: var(--color-info-bg);
+  color: var(--color-info);
+}
+
+.badge--neutral {
+  background: var(--color-surface-soft);
+  color: var(--color-text-secondary);
+}
+
+/* ---------- Formulaires ---------- */
+.field {
+  display: grid;
+  gap: var(--space-2);
+}
+
+.field__label {
+  font-size: var(--text-label);
+  font-weight: 600;
+  color: var(--color-text);
+}
+
+.field__hint {
+  font-size: var(--text-caption);
+  color: var(--color-text-muted);
+}
+
+.field__input,
+.field__select,
+.field__textarea {
+  width: 100%;
+  padding: var(--space-3) var(--space-4);
+  border: 1px solid var(--color-border-strong);
+  border-radius: var(--radius-md);
+  background: var(--color-surface);
+  font-size: var(--text-body);
+  transition:
+    border-color var(--motion-fast) var(--ease-standard),
+    box-shadow var(--motion-fast) var(--ease-standard);
+}
+
+.field__input:focus,
+.field__select:focus,
+.field__textarea:focus {
+  outline: none;
+  border-color: var(--color-primary);
+  box-shadow: 0 0 0 3px var(--color-accent-soft);
+}
+
+.field__input--error {
+  border-color: var(--color-error);
+}
+
+.field__error {
+  font-size: var(--text-caption);
+  color: var(--color-error);
+  display: flex;
+  align-items: center;
+  gap: var(--space-1);
+}
+
+.checkbox-row {
+  display: flex;
+  align-items: flex-start;
+  gap: var(--space-3);
+  cursor: pointer;
+}
+
+.checkbox-row input[type="checkbox"] {
+  width: 20px;
+  height: 20px;
+  margin-top: 2px;
+  accent-color: var(--color-primary);
+  flex-shrink: 0;
+}
+
+/* ---------- États vides / retours ---------- */
+.empty-state {
+  border: 1.5px dashed var(--color-border-strong);
+  border-radius: var(--radius-lg);
+  padding: var(--space-10) var(--space-6);
+  text-align: center;
+  background: rgba(255, 255, 255, 0.6);
+  display: grid;
+  gap: var(--space-3);
+  justify-items: center;
+}
+
+.empty-state svg {
+  color: var(--color-accent);
+}
+
+.alert {
+  display: flex;
+  gap: var(--space-3);
+  align-items: flex-start;
+  padding: var(--space-3) var(--space-4);
+  border-radius: var(--radius-md);
+  font-size: var(--text-body-sm);
+  border: 1px solid transparent;
+}
+
+.alert--error {
+  background: var(--color-error-bg);
+  color: var(--color-error);
+  border-color: rgba(180, 35, 53, 0.25);
+}
+
+.alert--info {
+  background: var(--color-info-bg);
+  color: var(--color-info);
+  border-color: rgba(36, 95, 168, 0.25);
+}
+
+/* ---------- Modal ---------- */
+.modal-backdrop {
+  position: fixed;
+  inset: 0;
+  background: var(--color-overlay);
+  display: grid;
+  place-items: center;
+  padding: var(--space-4);
+  z-index: 60;
+  animation: fade-in var(--motion-standard) var(--ease-standard);
+}
+
+.modal-panel {
+  background: var(--color-surface);
+  border-radius: var(--radius-xl);
+  box-shadow: var(--shadow-overlay);
+  width: 100%;
+  max-width: 520px;
+  max-height: calc(100dvh - var(--space-8));
+  overflow-y: auto;
+  padding: var(--space-6);
+  animation: rise-in var(--motion-emphasis) var(--ease-enter);
+}
+
+/* ---------- Toast ---------- */
+.toast-root {
+  position: fixed;
+  bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
+  left: 50%;
+  transform: translateX(-50%);
+  z-index: 80;
+  display: grid;
+  gap: var(--space-2);
+  width: min(92vw, 420px);
+}
+
+.toast {
+  background: var(--color-blue-deep);
+  color: #ffffff;
+  border-radius: var(--radius-md);
+  padding: var(--space-3) var(--space-4);
+  font-size: var(--text-body-sm);
+  box-shadow: var(--shadow-overlay);
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+  animation: rise-in var(--motion-emphasis) var(--ease-enter);
+}
+
+.toast--error {
+  background: var(--color-error);
+}
+
+/* ---------- Navigation expérience (anniversaire) ---------- */
+.top-nav {
+  position: sticky;
+  top: 0;
+  z-index: 40;
+  backdrop-filter: blur(10px);
+  background: rgba(247, 250, 255, 0.82);
+  border-bottom: 1px solid var(--color-border);
+}
+
+.top-nav__inner {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-3);
+  padding-block: var(--space-3);
+}
+
+.brand-mark {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-2);
+  font-family: var(--font-serif);
+  color: var(--color-blue-deep);
+  text-decoration: none;
+  font-size: 1.25rem;
+}
+
+/* ---------- Navigation espace quotidien (barre mobile / pilule desktop) ---------- */
+/* Dock (composant Stane) — menu principal de l'espace : rail flottant
+   centré, magnification douce au survol, libellés permanents,
+   page courante marquée au bleu majeur. */
+
+/* ============================================================
+   Scène d'introduction photographique des Souvenirs (3 oct. 2026)
+   La photo (statue du roi Béhanzin) se dévoile par mosaïque
+   (RefineFrame). data-phase: load | reveal | hand | gone.
+   ============================================================ */
+.souvenir-intro {
+  position: fixed;
+  inset: 0;
+  z-index: 80; /* au-dessus du chrome (top-nav 40, dock 60) */
+  display: grid;
+  place-items: center;
+  padding: clamp(16px, 4vw, 48px);
+  /* Durée du fondu = FADE_MS de SouvenirPhotoIntro (synchronisée). */
+  transition:
+    opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
+    visibility 0s linear 700ms;
+  opacity: 1;
+  visibility: visible;
+}
+.souvenir-intro__scrim {
+  position: absolute;
+  inset: 0;
+  background:
+    radial-gradient(120% 90% at 50% 0%, rgba(45, 101, 184, 0.6), transparent 60%),
+    linear-gradient(180deg, #0b1e3a 0%, #0f2444 55%, #0b1e3a 100%);
+}
+.souvenir-intro[data-phase="hand"] {
+  opacity: 0;
+  visibility: hidden;
+  pointer-events: none;
+}
+.souvenir-intro__frame {
+  position: relative;
+  display: grid;
+  justify-items: center;
+  gap: clamp(12px, 2.5vh, 20px);
+  margin: 0;
+}
+.souvenir-intro__refine {
+  box-shadow: 0 24px 90px rgba(3, 12, 30, 0.65);
+}
+.souvenir-intro__caption {
+  display: grid;
+  gap: 4px;
+  text-align: center;
+  color: #dcebff;
+}
+.souvenir-intro__kicker {
+  font-family: var(--font-mono);
+  font-size: 0.66rem;
+  letter-spacing: 0.2em;
+  text-transform: uppercase;
+  color: #8ec5ff;
+}
+.souvenir-intro__title {
+  font-family: var(--font-serif);
+  font-size: clamp(1.3rem, 3.4vw, 1.9rem);
+  color: #f2f8ff;
+}
+.souvenir-intro__loading {
+  position: relative;
+  color: #dcebff;
+  font-family: var(--font-mono);
+  font-size: 0.82rem;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  animation: souvenir-intro-breathe 1.8s ease-in-out infinite;
+}
+@keyframes souvenir-intro-breathe {
+  0%, 100% { opacity: 0.5; }
+  50% { opacity: 1; }
+}
+.souvenir-intro__skip {
+  position: absolute;
+  right: clamp(14px, 3.5vw, 36px);
+  bottom: clamp(14px, 4vh, 36px);
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 10px 16px;
+  border-radius: var(--radius-full);
+  border: 1px solid rgba(142, 197, 255, 0.4);
+  background: rgba(15, 36, 68, 0.55);
+  backdrop-filter: blur(8px);
+  color: #dcebff;
+  font-size: var(--text-body-sm);
+  font-weight: 600;
+  cursor: pointer;
+  transition: background 160ms ease, transform 160ms ease;
+}
+.souvenir-intro__skip:hover,
+.souvenir-intro__skip:focus-visible {
+  background: rgba(45, 101, 184, 0.7);
+  transform: translateY(-1px);
+}
+.souvenir-intro__skip:focus-visible {
+  outline: 2px solid #8ec5ff;
+  outline-offset: 2px;
+}
+@media (max-width: 560px) {
+  .souvenir-intro__skip {
+    right: 50%;
+    transform: translateX(50%);
